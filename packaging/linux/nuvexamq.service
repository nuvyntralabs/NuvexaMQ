[Unit]
Description=NuvexaMQ message broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nuvexamq
Group=nuvexamq
WorkingDirectory=/var/lib/nuvexamq
ExecStart=/usr/bin/nuvexamq --data /var/lib/nuvexamq
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
