<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Nuventra.NuvexaMQ.Server</RootNamespace>
    <AssemblyName>nuvexamq</AssemblyName>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Description>NuvexaMQ broker host. TCP on port 5761, health and metrics on port 5762, management on port 5763.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="console.html" />
    <EmbeddedResource Include="icon.png" />
    <Content Update="appsettings.json" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nuventra.NuvexaMQ.Engine\Nuventra.NuvexaMQ.Engine.csproj" />
    <ProjectReference Include="..\Nuventra.NuvexaMQ.Protocol\Nuventra.NuvexaMQ.Protocol.csproj" />
    <ProjectReference Include="..\Nuventra.NuvexaMQ.Client\Nuventra.NuvexaMQ.Client.csproj" />
  </ItemGroup>

</Project>
